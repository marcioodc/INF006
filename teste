#include <stdio.h>
#include <string.h>
#include <stdlib.h>

void insertion_sort(int * A, int tam){
    for(int j = 1; j < tam; j = j +1){
        int key = A[j];
        int i = j-1;
        while(i >= 0 && A[i]>key){
            A[i+1] = A[i];
            i = i -1;
        }
        A[i+1] = key;
    }
}

int main(){
    
    char numeros[100];//ler numeros
    const char separador[] = "+";
    char * result;
    printf("Informe os números: ");
    fgets(numeros, sizeof(numeros), stdin);
  
    result = strtok(numeros, separador);
    
    int valores[100] = 0;
    int qtd = 0;
    while(result != NULL){
        valores[qtd++] = atoi(result);
        result = strtok(NULL, separador);
    }
    insertion_sort(valores, qtd);
    for(int i = 0; i < qtd; i++){
        if(i > 0) printf("+");
        printf("%d + ", valores[i]);
    }
    printf("\n");

    return 0;
}
